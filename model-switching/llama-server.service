[Unit]
Description=llama.cpp Server (user)
After=network.target

[Service]
Type=simple
EnvironmentFile=%h/home-ai-server/model-switching/active.conf
ExecStart=%h/llama.cpp/build/bin/llama-server \
    -m %h/models/${MODEL_NAME} \
    --mmproj %h/models/${MMPROJ_NAME} \
    -ngl ${GPU_LAYERS} \
    --host ${HOST} \
    --port ${PORT} \
    -c ${CTX_SIZE} \
    --flash-attn on \
    --cache-type-k ${CACHE_TYPE_K} \
    --cache-type-v ${CACHE_TYPE_V}
    --webui-mcp-proxy
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
