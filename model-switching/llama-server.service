[Unit]
Description=llama.cpp Server (user, router mode)
After=network.target

[Service]
Type=simple
ExecStart=%h/llama.cpp/build/bin/llama-server \
    --models-dir %h/models \
    --models-preset %h/home-ai-server/model-switching/models.preset.ini \
    --models-max 1 \
    --host 0.0.0.0 \
    --port 8080 \
    --webui-mcp-proxy
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
