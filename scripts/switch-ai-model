#!/usr/bin/env bash
# Switch the AI server model and point this machine's opencode at it.
# Usage: ./scripts/switch-ai-model {27b|35b|status}
#
# Server: llama.cpp in router mode (see model-switching/README.md)
# API: http://100.89.219.6:8080
set -euo pipefail

API="http://100.89.219.6:8080"
CFG="$HOME/.config/opencode/opencode.json"

case "${1:-}" in
    27b) model="Qwen3.8-27B-Q4_K_M" ;;
    35b) model="Qwen_Qwen3.6-35B-A3B-Q4_K_M" ;;
    status)
        curl -sS "$API/models" | jq -r '.data[] | "\(.id)  [\(.status.value)]"'
        exit 0
        ;;
    -h|--help|help)
        echo "Usage: $0 {27b|35b|status}"
        echo ""
        echo "Switch the AI server at 100.89.219.6 to the given model and update opencode's model."
        exit 0
        ;;
    *)
        echo "Usage: $0 {27b|35b|status}" >&2
        exit 1
        ;;
esac

echo "Switching AI server to $model (old model purged first; ~15-30s)..."
curl -sS -X POST "$API/models/load" -H 'Content-Type: application/json' -d "{\"model\":\"$model\"}" >/dev/null

for _ in $(seq 1 90); do
    st="$(curl -sS "$API/models" | jq -r --arg m "$model" '.data[] | select(.id == $m) | .status.value' 2>/dev/null || true)"
    if [[ "$st" == "loaded" ]]; then break; fi
    sleep 1
done

st="$(curl -sS "$API/models" | jq -r --arg m "$model" '.data[] | select(.id == $m) | .status.value' 2>/dev/null || true)"
if [[ "$st" != "loaded" ]]; then
    echo "Warning: $model is no longer loaded — another client likely reloaded a different model." >&2
fi

if [[ -f "$CFG" ]]; then
    jq --arg m "$model" --arg n "local model ($1)" '
        .provider["llama-cpp"].models = {
            ($m): {
                name: $n,
                tool_call: true,
                limit: { context: 130000, output: 8192 },
                modalities: { input: ["text", "image"], output: ["text"] }
            }
        }' "$CFG" > "$CFG.tmp" && mv "$CFG.tmp" "$CFG"
    echo "opencode model -> $model (applies to new sessions)"
fi

curl -sS "$API/models" | jq -r '.data[] | "  \(.id)  [\(.status.value)]"'
